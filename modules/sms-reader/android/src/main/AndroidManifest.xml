<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- [ADD — Nov 4] SMS listener. Merged into the app automatically.
         android:permission makes sure only the phone's system can send it. -->
    <receiver
      android:name="expo.modules.smsreader.SmsListenerReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
